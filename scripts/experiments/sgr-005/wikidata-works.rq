SELECT ?author ?authorLabel ?birth ?death ?work ?workLabel ?date ?pg WHERE {
  ?work wdt:P2034 ?pg ; wdt:P50 ?author ; wdt:P577 ?date ; wdt:P407 wd:Q1860 .
  ?author wdt:P569 ?birth ; wdt:P570 ?death .
  { ?author wdt:P103 wd:Q1860 } UNION { ?author wdt:P6886 wd:Q1860 } UNION { ?author wdt:P1412 wd:Q1860 }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en". }
}
